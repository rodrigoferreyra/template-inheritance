{
  "name": "template-inheritance",
  "version": "1.0.0",
  "description": "CE.SDK swag catalog with template inheritance — master + customer overrides + product catalog → print plates and mockups",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "secrets": "bash scripts/setup-secrets.sh",
    "dev": "vite",
    "prebuild": "npm run check:all",
    "build": "vite build",
    "preview": "vite preview",
    "check:syntax": "tsc --project tsconfig.json --noEmit",
    "check:format": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"vite*.ts\" \"package.json\" \"README.md\"",
    "check:lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check:all": "npm run check:syntax && npm run check:format && npm run check:lint",
    "fix:format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"vite*.ts\" \"package.json\" \"README.md\"",
    "fix:lint": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "fix:all": "npm run fix:format && npm run fix:lint",
    "test:unit": "tsx scripts/smoke-catalog-resolve.ts",
    "test:integration": "exit 0",
    "test:component": "exit 0",
    "test:e2e": "exit 0",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:component && npm run test:e2e",
    "qa": "npm run check:all && npm run test:unit",
    "ci": "npm run check:all && npm run test:all",
    "render:catalog": "tsx scripts/render-catalog.ts"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "1.76.2-rc.1",
    "@cesdk/engine": "1.76.2-rc.1",
    "@cesdk/node": "1.76.2-rc.1",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.50.0",
    "eslint-plugin-deprecation": "^3.0.0",
    "eslint-plugin-jsdoc": "^46.0.0",
    "playwright": "^1.55.1",
    "prettier": "^3.0.0",
    "sharp": "^0.34.4",
    "tsx": "^4.23.13",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.2": true
  }
}
